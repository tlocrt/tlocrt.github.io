  <tbody>
      <tr>
          <td style="text-align: center"><code>z</code></td>
          <td style="text-align: center">Zoom in track (fit height)</td>
      </tr>
      <tr>
          <td style="text-align: center"><code>t</code></td>
          <td style="text-align: center">Changing the cursor tool</td>
      </tr>
      <tr>
          <td style="text-align: center"><code>Cmd</code></td>
          <td style="text-align: center">Temporary switch to chosen &ldquo;right click&rdquo; tool (which should be marquee)</td>
      </tr>
      <tr>
          <td style="text-align: center"><code>Ctrl Alt G</code></td>
          <td style="text-align: center">Normalize region gain</td>
      </tr>
      <tr>
          <td style="text-align: center"><code>Ctrl Shift R</code></td>
          <td style="text-align: center">Reverse region (also in Editors &gt; File &gt; Functions &gt; Reverse)</td>
